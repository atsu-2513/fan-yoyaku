# LINE Developers Console > Messaging API channel から取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 予約ページ・管理画面を公開するベースURL（末尾スラッシュなし）
# 例: https://fan-yoyaku.example.com
# ローカル動作確認時は ngrok 等のURLを設定
BASE_URL=http://localhost:3000

# 管理画面(オーナー用、Basic認証)のID/パスワード
ADMIN_USER=owner
ADMIN_PASS=changeme

# スタッフ画面のログインセッション(Cookie)を署名するための秘密鍵。
# 本番では必ず長いランダム文字列に変更すること。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-please-generate-a-random-string

# サーバーのポート
PORT=3000

# 前日リマインド通知エンドポイント(/api/cron/send-reminders)を外部の無料スケジューラ
# (cron-job.org等)から呼び出す際に使う合言葉。他人に推測されない適当な文字列にすること。
# 生成例: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=

# データベース(Turso/libSQL)
# 未設定の場合はローカルの data/fan-yoyaku.db を使用（開発用）。
# Vercel/Render等サーバーレス・コンテナ環境ではファイルシステムが永続化されないため、
# 本番では必ず Turso のDB URL / トークンを設定すること。
# 取得方法: `turso db create fan-yoyaku` → `turso db show fan-yoyaku --url` /
#          `turso db tokens create fan-yoyaku`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# メール通知(新規予約が入った時に、担当スタッフとオーナーに送る)
# Brevo(無料プランあり・独自ドメイン不要)のAPIキーを設定する。
# 1. https://www.brevo.com/ で無料アカウントを作成
# 2. 「Senders, Domains & Dedicated IPs」で送信元にしたいメールアドレス(オーナーの普段使っているメール等)を
#    「Add a sender」から登録し、届いた6桁コードで認証する(独自ドメインは不要)
# 3. 「SMTP & API」>「API Keys」から新しいAPIキーを発行し、BREVO_API_KEYに設定
BREVO_API_KEY=
# 上記2で認証した送信元メールアドレス
MAIL_FROM_ADDRESS=
# 送信者名(任意。未設定なら「hair salon FAN」)
MAIL_FROM_NAME=hair salon FAN
# オーナー自身が予約通知を受け取りたいメールアドレス
OWNER_EMAIL=
