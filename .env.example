# LINE Developers Console > Messaging API channel から取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 予約ページ・管理画面を公開するベースURL（末尾スラッシュなし）
# 例: https://fan-yoyaku.example.com
# ローカル動作確認時は ngrok 等のURLを設定
BASE_URL=http://localhost:3000

# 管理画面(オーナー用、Basic認証)のID/パスワード
ADMIN_USER=owner
ADMIN_PASS=changeme

# スタッフ画面のログインセッション(Cookie)を署名するための秘密鍵。
# 本番では必ず長いランダム文字列に変更すること。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-please-generate-a-random-string

# サーバーのポート
PORT=3000

# データベース(Turso/libSQL)
# 未設定の場合はローカルの data/fan-yoyaku.db を使用（開発用）。
# Vercel/Render等サーバーレス・コンテナ環境ではファイルシステムが永続化されないため、
# 本番では必ず Turso のDB URL / トークンを設定すること。
# 取得方法: `turso db create fan-yoyaku` → `turso db show fan-yoyaku --url` /
#          `turso db tokens create fan-yoyaku`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
